# LLM + Embeddings (required for RAG)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Market data APIs (optional)
POLYGON_API_KEY=your_polygon_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
STOCKSERA_API_KEY=your_stocksera_api_key_here

# Telegram (private mode)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-BotFather
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id
PRIVATE_MODE=true

# Supabase (SaaS mode — set PRIVATE_MODE=false)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# SEC (required — must include real email)
SEC_USER_AGENT=SecDilutionTracker your.email@example.com

# Paths
DATA_DIR=../data
CHROMA_DIR=../data/chroma

# Server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Monitor
RSS_POLL_INTERVAL_SECONDS=120
