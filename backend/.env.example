# LLM + Embeddings (required for RAG)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Market data APIs (optional — news aggregator uses all configured sources)
POLYGON_API_KEY=your_polygon_api_key_here
MASSIVE_API_KEY=your_massive_api_key_here
# Massive = Polygon rebrand (same key). News: GET /v2/reference/news + sentiment insights
FINNHUB_API_KEY=your_finnhub_api_key_here
BENZINGA_API_KEY=your_benzinga_api_key_here
STOCKSERA_API_KEY=your_stocksera_api_key_here
EODHD_API_KEY=your_eodhd_api_key_here
# EODHD free tier: ~20 calls/day — used for news only (6h cache per ticker)

# NewsAPI.org — optional, NOT integrated yet (reference only)
# Docs: https://newsapi.org/docs/get-started — free dev tier ~100 req/day
NEWS_API_KEY=your_newsapi_key_here

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-BotFather
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id
SEC_USER_AGENT=SecDilutionTracker your.email@example.com

# Paths
DATA_DIR=../data
CHROMA_DIR=../data/chroma

# Server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Monitor
RSS_POLL_INTERVAL_SECONDS=120
