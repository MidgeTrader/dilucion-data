# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a backend/.env y pon TUS claves.
#   cp backend/.env.example backend/.env
# .env está en .gitignore: nunca se sube. Si haces un fork o una copia, cada
# persona pone las suyas — las de este repo no sirven para nadie más.
# ─────────────────────────────────────────────────────────────────────────────

# ── IA: chat (obligatorio para RAG y reportes) ───────────────────────────────
# Cualquier proveedor compatible con la API de OpenAI sirve.
# Por defecto apunta a DeepSeek; para usar OpenAI, mira docs/CONFIGURACION_IA.md
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_REASONING_MODEL=deepseek-reasoner
# Si no defines LLM_API_KEY se usa DEEPSEEK_API_KEY.
LLM_API_KEY=

# Atajo equivalente a LLM_API_KEY, mantenido por compatibilidad.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── IA: embeddings (obligatorio para RAG) ────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=            # solo si usas un servidor local tipo Ollama

# ── APIs de mercado (opcionales; el agregador usa las que estén configuradas) ─
POLYGON_API_KEY=your_polygon_api_key_here
MASSIVE_API_KEY=your_massive_api_key_here
# Massive = Polygon rebrand (misma clave). News: /v2/reference/news + sentimiento
FINNHUB_API_KEY=your_finnhub_api_key_here
BENZINGA_API_KEY=your_benzinga_api_key_here
STOCKSERA_API_KEY=your_stocksera_api_key_here
EODHD_API_KEY=your_eodhd_api_key_here
# EODHD free tier: ~20 llamadas/día — solo noticias (caché de 6h por ticker)

# NewsAPI.org — opcional, NO integrado todavía (solo referencia)
# Docs: https://newsapi.org/docs/get-started — free dev ~100 req/día
NEWS_API_KEY=your_newsapi_key_here

# ── Alertas de Telegram (opcional) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-BotFather
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id

# SEC EDGAR exige un User-Agent identificable con un correo real de contacto.
SEC_USER_AGENT=SecDilutionTracker your.email@example.com

# ── Rutas ────────────────────────────────────────────────────────────────────
DATA_DIR=../data
CHROMA_DIR=../data/chroma

# ── Servidor ─────────────────────────────────────────────────────────────────
# 127.0.0.1 y no 0.0.0.0: con 0.0.0.0 el backend (y su proxy de IA) queda
# alcanzable desde toda la LAN sin autenticación. Pon la IP solo si de verdad
# necesitas exponerlo.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Monitor ──────────────────────────────────────────────────────────────────
RSS_POLL_INTERVAL_SECONDS=120
